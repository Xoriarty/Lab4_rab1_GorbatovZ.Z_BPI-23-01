<Window x:Class="Lab4_rab1_GorbatovZ.Z_BPI_23_01.View.WindowRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab4_rab1_GorbatovZ.Z_BPI_23_01.View"
        mc:Ignorable="d"
        Title="WindowRole" Height="450" Width="800">
    <StackPanel Background="#FFD8D8D8">
        <Label Margin="5" HorizontalAlignment="Center">Список должностей сотрудников</Label>
        <ListView x:Name="lvRole" Background="#FFD3CDCD" ItemsSource="{Binding ListRole}" SelectedItem="{Binding SelectedRole}">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Код" Width="50" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Наименование должности" DisplayMemberBinding="{Binding NameRole}"/>
                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Name="btnAdd" Grid.Column="0" Content="Добавить" Height="25" Width="100" Command="{Binding AddRole}"/>
            <Button Name="btnEdit" Grid.Column="1" Content="Редактировать" Height="25" Width="100" Command="{Binding EditRole}"/>
            <Button Name="btnDelete" Grid.Column="2" Content="Удалить" Height="25" Width="100" Command="{Binding DeleteRole}"/>

        </Grid>
    </StackPanel>
</Window>
